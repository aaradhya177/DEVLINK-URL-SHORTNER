DATABASE_URL=postgresql+asyncpg://devlink:devlink@localhost:5432/devlink
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:9092
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
DEVLINK_WORKER_ID=1
RATE_LIMIT_READ_REQUESTS=300
RATE_LIMIT_WRITE_REQUESTS=60
RATE_LIMIT_BULK_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
GOOGLE_SAFE_BROWSING_API_KEY=
URL_SAFETY_TIMEOUT_SECONDS=0.4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
REDIS_MAX_CONNECTIONS=100
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_PRIVATE_REDIRECT_URLS=false
REDIRECT_PASSWORD_ATTEMPT_LIMIT=10
REDIRECT_PASSWORD_ATTEMPT_WINDOW_SECONDS=60
APP_ENV=local
LOG_LEVEL=INFO

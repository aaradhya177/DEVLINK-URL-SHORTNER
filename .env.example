# Production compose placeholders. Copy to .env and replace every secret value
# before running infra/docker-compose.prod.yml.

POSTGRES_DB=devlink
POSTGRES_USER=devlink
POSTGRES_PASSWORD=replace-with-a-random-postgres-password

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

IP_HASH_SECRET=replace-with-a-random-privacy-salt-secret

APP_ENV=production
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:8080
ALLOW_PRIVATE_REDIRECT_URLS=false

WEB_PORT=8080
VITE_API_BASE_URL=

CLICK_EVENTS_TOPIC=click-events
KAFKA_GROUP_ID=devlink-analytics-worker

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
REDIS_MAX_CONNECTIONS=100

RATE_LIMIT_READ_REQUESTS=300
RATE_LIMIT_WRITE_REQUESTS=60
RATE_LIMIT_BULK_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
REDIRECT_PASSWORD_ATTEMPT_LIMIT=10
REDIRECT_PASSWORD_ATTEMPT_WINDOW_SECONDS=60

GOOGLE_SAFE_BROWSING_API_KEY=
URL_SAFETY_TIMEOUT_SECONDS=0.4
